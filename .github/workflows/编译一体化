#============================================================================================
# https://github.com/P3TERX/Actions-OpenWrt
# https://github.com/ophub/amlogic-s9xxx-openwrt
# https://github.com/3wlh/Actions-OpenWrt
# openwrt:一体化工作流
# 功能:选择源码→加载自定义配置→生成配置→自动保存配置→编译固件→发布版本
# 修复项：补充仓库写入权限、精简冗余命令、修复语法风险、优化日志、保留全部旧代码注释
# 缓存优化：分离源码/缓存目录，修复hashFiles失效，消除git clone目录冲突，提升缓存命中率
#============================================================================================
name: OpenWrt 配置生成+自动编译一体化

permissions:
  contents: write
  actions: write

on:
  repository_dispatch:
  workflow_dispatch:
    inputs:
      source_repo:
        description: "选择 OpenWrt 源码仓库"
        required: true
        default: "kygs-immortalwrt-master"
        type: choice
        options:
          - lede-master
          - openwrt-main
          - openwrt-24.10
          - openwrt-23.05
          - immortalwrt-master
          - immortalwrt-24.10
          - istoreos-master
          - kygs-immortalwrt-master
          - kygs-istoreos-24.10
          
      version_tag:
        description: "选择源码版本 Tag（ latest = 最新代码；openwrt-24.10 为分支，其余v开头为版本标签）"
        required: true
        default: "latest"
        type: choice
        options:
          - latest
          - openwrt-24.10
          - v24.10.1
          - v23.05.0
          - v23.05.1
          - v23.05.2
          - v23.05.3
          - v23.05.4
          
      ssh:
        description: "启用 SSH 连接（可在线 make menuconfig）"
        required: false
        default: true
        type: boolean
        
      config_save_path:
        description: "配置文件保存到仓库的路径（默认即可）"
        required: true
        default: ".config"
        type: text

      delete_last_release:
        description: "是否删除【上一个旧版本】？默认不删除"
        required: false
        default: "false"
        type: boolean

      use_cache:
        description: "是否使用编译缓存（关闭则本次不加载旧缓存，但仍会保存本次编译结果）"
        required: false
        default: "true"
        type: boolean

env:
  FEEDS_CONF: feeds.conf.default
  DIY_P1_SH: diy-part1.sh
  DIY_P2_SH: diy-part2.sh
  DIY_P3_SH: diy-part3.sh
  TZ: Asia/Shanghai
  UPLOAD_RELEASE: true
  UPLOAD_FIRMWARE: true
  UPLOAD_BIN_DIR: true
  CONFIG_CCACHE: y
  CCACHE_DIR: /builder/ccache
  VERSION_TAG: ${{ github.event.inputs.version_tag }}

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
    - name: 检出仓库代码
      uses: actions/checkout@v4
      with:
        persist-credentials: true

    # ==================== 编译环境 ====================
    - name: 安装编译环境依赖
      env:
        DEBIAN_FRONTEND: noninteractive
      run: |
        sudo -E apt-get -qq update
        sudo -E apt-get -qq install build-essential ccache cmake flex bison gawk \
          gcc-multilib g++-multilib libncurses5-dev python3 git wget curl zip unzip \
          bzip2 p7zip-full rsync file gettext libssl-dev libelf-dev autopoint \
          libtool-bin perl
        sudo -E apt-get -qq autoremove --purge
        sudo -E apt-get -qq clean
        sudo timedatectl set-timezone "$TZ"
        sudo mkdir -p /builder
        sudo chown $USER:$GROUPS /builder
        ccache -M 10G

    - name: 自动匹配仓库地址与分支
      id: repo
      run: |
        case "${{ github.event.inputs.source_repo }}" in
          lede-master)
            REPO_URL="https://github.com/coolsnowwolf/lede"
            REPO_BRANCH="master" ;;
          openwrt-main)
            REPO_URL="https://github.com/openwrt/openwrt"
            REPO_BRANCH="main" ;;
          openwrt-24.10)
            REPO_URL="https://github.com/openwrt/openwrt"
            REPO_BRANCH="openwrt-24.10" ;;
          openwrt-23.05)
            REPO_URL="https://github.com/openwrt/openwrt"
            REPO_BRANCH="openwrt-23.05" ;;
          immortalwrt-master)
            REPO_URL="https://github.com/immortalwrt/immortalwrt"
            REPO_BRANCH="master" ;;
          immortalwrt-24.10)
            REPO_URL="https://github.com/immortalwrt/immortalwrt"
            REPO_BRANCH="openwrt-24.10" ;;
          istoreos-master)
            REPO_URL="https://github.com/istoreos/istoreos"
            REPO_BRANCH="main" ;;
          kygs-immortalwrt-master)
            REPO_URL="https://github.com/kygsmsc/immortalwrt"
            REPO_BRANCH="master" ;;
          kygs-istoreos-24.10)
            REPO_URL="https://github.com/kygsmsc/istoreos"
            REPO_BRANCH="istoreos-24.10" ;;
          *)
            echo "::error::未定义仓库" && exit 1 ;;
        esac

        echo "REPO_URL=$REPO_URL" >> $GITHUB_OUTPUT
        echo "REPO_BRANCH=$REPO_BRANCH" >> $GITHUB_OUTPUT

        echo "正在校验远程分支: $REPO_BRANCH"
        if ! git ls-remote --heads "$REPO_URL" | grep -q "refs/heads/$REPO_BRANCH"; then
          echo "::error::远程仓库不存在分支 $REPO_BRANCH，请重新选择源码仓库！"
          exit 1
        fi

    # ==================== 克隆源码 ====================
    - name: 克隆 OpenWrt 源码
      id: clone_src
      working-directory: /builder
      run: |
        rm -rf openwrt
        git clone -b ${{ steps.repo.outputs.REPO_BRANCH }} \
          ${{ steps.repo.outputs.REPO_URL }} openwrt

        ln -sf /builder/openwrt $GITHUB_WORKSPACE/openwrt
        cd openwrt

        mkdir -p /builder/dl /builder/build_dir /builder/staging_dir /builder/ccache
        ln -sf /builder/dl dl
        ln -sf /builder/build_dir build_dir
        ln -sf /builder/staging_dir staging_dir

        TAG_INPUT="${{ github.event.inputs.version_tag }}"
        if [[ "$TAG_INPUT" == "latest" ]]; then
          echo "✅ 使用默认分支最新代码"
        elif [[ "$TAG_INPUT" =~ ^v[0-9] ]]; then
          git fetch --tags
          if ! git rev-parse "tags/$TAG_INPUT" >/dev/null 2>&1; then
            echo "::error::标签 $TAG_INPUT 不存在"
            exit 1
          fi
          git checkout -b tag_build_$TAG_INPUT $TAG_INPUT
        else
          git fetch --tags
          if git rev-parse "tags/$TAG_INPUT" >/dev/null 2>&1; then
            git checkout -b tag_build_$TAG_INPUT $TAG_INPUT
          else
            git fetch origin "$TAG_INPUT":"$TAG_INPUT"
            git checkout "$TAG_INPUT"
          fi
        fi

        echo "status=success" >> ${GITHUB_OUTPUT}

    - name: 加载 feeds 配置
      run: |
        cd openwrt
        if [[ -f "$FEEDS_CONF" && "$FEEDS_CONF" != "feeds.conf.default" ]]; then
          cp -f "$FEEDS_CONF" feeds.conf.default
        fi

    - name: 执行自定义脚本1
      run: |
        chmod +x $DIY_P1_SH
        cd openwrt
        $GITHUB_WORKSPACE/$DIY_P1_SH

    - name: 更新并安装 feeds
      run: |
        cd openwrt
        ./scripts/feeds update -a
        ./scripts/feeds install -a

    - name: 加载自定义配置
      run: |
        [ -e files ] && cp -rf files openwrt/
        CFG_FILE="${{ github.event.inputs.config_save_path }}"
        if [[ -f "${CFG_FILE}" ]]; then
          cp -f "${CFG_FILE}" openwrt/.config
          echo "✅ 成功加载配置文件 ${CFG_FILE}"
        else
          echo "⚠️ 未找到配置文件，使用源码默认配置"
        fi

    - name: 执行自定义脚本2
      run: |
        chmod +x $DIY_P2_SH
        cd openwrt
        $GITHUB_WORKSPACE/$DIY_P2_SH

    - name: SSH 远程连接（可选）
      if: github.event.inputs.ssh == 'true'
      uses: rdp-studio/ssh2actions@main
      env:
        TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
        TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}

    - name: 生成 .config 配置文件
      run: |
        cd openwrt
        make defconfig
        echo "FILE_DATE=$(date +%Y%m%d%H%M)" >> $GITHUB_ENV

    # ==================== ✅ 缓存 Key（必须在 .config 生成后） ====================
    - name: 设置缓存 Key
      id: cache_key
      run: |
        CONFIG_HASH="none"
        if [ -f openwrt/.config ]; then
          CONFIG_HASH=$(sha256sum openwrt/.config | cut -d' ' -f1)
        fi
        echo "CONFIG_HASH=${CONFIG_HASH}" >> $GITHUB_OUTPUT

    # ==================== ✅ 统一缓存（核心修改点） ====================
    - name: 缓存 OpenWrt 编译文件
      uses: actions/cache@v4
      with:
        path: |
          /builder/dl
          /builder/build_dir
          /builder/staging_dir
          /builder/ccache
        key: openwrt-${{ github.event.inputs.source_repo }}-${{ env.VERSION_TAG }}-${{ steps.cache_key.outputs.CONFIG_HASH }}
        restore-keys: |
          openwrt-${{ github.event.inputs.source_repo }}-${{ env.VERSION_TAG }}-
          openwrt-${{ github.event.inputs.source_repo }}-
        lookup-only: ${{ github.event.inputs.use_cache != 'true' }}

    - name: 自动保存配置文件到仓库
      run: |
        cd "$GITHUB_WORKSPACE"
        CONFIG_PATH="${{ github.event.inputs.config_save_path }}"

        echo -e "\033[34m===== .config 内容 =====\033[0m"
        cat openwrt/.config
        echo -e "\033[34m=======================\033[0m"

        cp -f openwrt/.config "$CONFIG_PATH"

        git config --global user.name "GitHub Actions"
        git config --global user.email "actions@github.com"
        git add -f "$CONFIG_PATH"
        git commit -m "Auto update config [$(date +%Y-%m-%d)]" --allow-empty || true
        git push
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      continue-on-error: true

    - name: 下载编译依赖
      run: |
        cd openwrt
        make defconfig
        make download -j$(nproc)
        find dl -size -1024c -delete

    - name: 开始编译固件
      id: compile_firmware
      if: steps.clone_src.outputs.status == 'success'
      run: |
        cd openwrt
        make -j$(nproc) V=w
        echo "status=success" >> $GITHUB_OUTPUT
        grep '^CONFIG_TARGET.*DEVICE.*=y' .config \
          | sed -r 's/.*DEVICE_(.*)=y/\1/' > DEVICE_NAME
        [ -s DEVICE_NAME ] && echo "DEVICE_NAME=_$(cat DEVICE_NAME)" >> $GITHUB_ENV
        echo "FILE_DATE=_$(date +%Y%m%d%H%M)" >> $GITHUB_ENV

    - name: 检查磁盘空间
      if: (!cancelled())
      run: df -hT

    - name: 上传 bin 目录产物
      uses: actions/upload-artifact@v4
      if: steps.compile_firmware.outputs.status == 'success' && env.UPLOAD_BIN_DIR == 'true'
      with:
        name: OpenWrt_bin${{ env.DEVICE_NAME }}${{ env.FILE_DATE }}
        path: openwrt/bin

    - name: 整理固件目录
      id: organize
      if: env.UPLOAD_FIRMWARE == 'true' && !cancelled()
      run: |
        cd openwrt/bin/targets/*/*
        rm -rf packages
        echo "FIRMWARE=$PWD" >> $GITHUB_ENV
        echo "status=success" >> $GITHUB_OUTPUT

    - name: 上传固件目录
      uses: actions/upload-artifact@v4
      if: steps.organize.outputs.status == 'success' && !cancelled()
      with:
        name: OpenWrt_firmware${{ env.DEVICE_NAME }}${{ env.FILE_DATE }}
        path: ${{ env.FIRMWARE }}

    - name: 生成发布标签
      id: tag
      if: env.UPLOAD_RELEASE == 'true' && !cancelled()
      run: |
        echo "release_tag=$(date +%Y.%m.%d-%H%M)" >> $GITHUB_OUTPUT
        touch release.txt
        echo "status=success" >> $GITHUB_OUTPUT

    - name: 创建版本发布
      uses: softprops/action-gh-release@v1
      if: steps.tag.outputs.status == 'success' && !cancelled()
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        tag_name: ${{ steps.tag.outputs.release_tag }}
        body_path: release.txt
        files: ${{ env.FIRMWARE }}/*

    - name: 清理历史工作流记录
      uses: Mattraks/delete-workflow-runs@v2
      with:
        retain_days: 7
        keep_minimum_runs: 3

    - name: 删除旧版本 Release
      if: github.event.inputs.delete_last_release == 'true' && env.UPLOAD_RELEASE == 'true' && !cancelled()
      uses: dev-drprasad/delete-older-releases@v0.3.0
      with:
        keep_latest: 1
        delete_tags: true
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
